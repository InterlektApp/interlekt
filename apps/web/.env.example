# Server-side backend origin used by the Next.js /api/v1 rewrite.
# Local default: http://localhost:8001. Production defaults to the deployed Render API.
# If overriding in Vercel, use the origin only (no /docs and no /api/v1 suffix).
API_ORIGIN=http://localhost:8001

# Legacy local-development alias. The production build uses API_ORIGIN or the Render default.
NEXT_PUBLIC_API_URL=http://localhost:8001
APP_ORIGIN=http://localhost:3000

# Cloudinary (public, safe for browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD=out05vii
NEXT_PUBLIC_CLOUDINARY_PRESET=interlekt

# Paystack (public key only — secret key lives on the backend)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Google OAuth (public client ID only — the secret lives on the backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
